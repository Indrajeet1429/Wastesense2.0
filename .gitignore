# ==============================
# WASTESENSE - Git Ignore
# ==============================

# Environment / secrets
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
.venv312/
venv/
env/

# Jupyter
.ipynb_checkpoints/

# ML model artifacts
ml/artifacts/models/*
ml/artifacts/preprocessors/*

# Keep artifact directories
!ml/artifacts/models/.gitkeep
!ml/artifacts/preprocessors/.gitkeep

# Large datasets
data/raw/*
data/interim/*
data/processed/*

# Keep data directory structure
!data/raw/.gitkeep
!data/interim/.gitkeep
!data/processed/.gitkeep

# Logs
logs/*
!logs/.gitkeep
!logs/api/.gitkeep
!logs/worker/.gitkeep
!logs/ml/.gitkeep

# Frontend
frontend/node_modules/
frontend/dist/

# Build / cache
dist/
build/
*.egg-info/

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db
desktop.ini

# Temporary files
*.tmp
*.temp
*.log

# Jupyter generated files
*.ipynb_checkpoints

# Local databases
*.db
*.sqlite
*.sqlite3